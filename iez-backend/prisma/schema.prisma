generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TABELA DE DOCUMENTOS
model Documento {
  id                String   @id @default(uuid())
  titulo            String
  categoria         String
  nivelAcesso       String   
  regraVisibilidade String   
  empresa           String?  
  descricao         String?
  arquivoUrl        String   
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
}

// TABELA DE USUÁRIOS E GESTÃO DE ACESSOS
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("PARTNER") // "ADMIN" ou "PARTNER"
  empresa   String
  status    String   @default("ATIVO")   // "ATIVO", "PENDENTE", "BLOQUEADO"
  criadoEm  DateTime @default(now())
}