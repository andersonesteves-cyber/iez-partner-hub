generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Mudamos de sqlite para postgresql
  url      = env("DATABASE_URL")
}

// ... (O resto das tabelas Documento e Usuario continua EXATAMENTE igual)

// TABELA DE DOCUMENTOS
model Documento {
  id                String   @id @default(uuid())
  titulo            String
  resumo            String?  // <-- NOVO CAMPO ADICIONADO AQUI
  categoria         String
  nivelAcesso       String   @default("TODOS")
  regraVisibilidade String   @default("GERAL")
  arquivoUrl        String
  enviadoPor        String?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
}

// TABELA DE USUÁRIOS E GESTÃO DE ACESSOS
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("PARTNER") // "ADMIN" ou "PARTNER"
  empresa   String
  status    String   @default("ATIVO")   // "ATIVO", "PENDENTE", "BLOQUEADO"
  criadoEm  DateTime @default(now())
}